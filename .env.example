# --- LLM (choose one provider; anthropic is default) ---
SS_LLM_PROVIDER=anthropic            # anthropic | groq | azure_openai
SS_ANTHROPIC_API_KEY=
SS_ANTHROPIC_MODEL_STANDARD=claude-sonnet-4-6
SS_ANTHROPIC_MODEL_VISION=claude-sonnet-4-6
# Groq (only if SS_LLM_PROVIDER=groq) -- free/cheap open-weight models,
# useful to keep testing cost at $0 before switching to anthropic
SS_GROQ_API_KEY=
SS_GROQ_MODEL_STANDARD=llama-3.3-70b-versatile
SS_GROQ_MODEL_VISION=llama-3.2-90b-vision-preview
# Azure OpenAI (only if SS_LLM_PROVIDER=azure_openai)
# SS_AZURE_OPENAI_ENDPOINT format: https://<resource>.openai.azure.com
SS_AZURE_OPENAI_ENDPOINT=
SS_AZURE_OPENAI_API_KEY=
# SS_AZURE_OPENAI_DEPLOYMENT_STANDARD, e.g. gpt-4o deployment name
SS_AZURE_OPENAI_DEPLOYMENT_STANDARD=
# SS_AZURE_OPENAI_DEPLOYMENT_VISION: vision-capable deployment name
SS_AZURE_OPENAI_DEPLOYMENT_VISION=
SS_AZURE_OPENAI_API_VERSION=2024-10-21

# --- Generation providers ---
SS_REPLICATE_API_TOKEN=
# xai/grok-imagine-video handles i2v and t2v via one model id; point both at
# wan-video/wan-2.2-{i2v,t2v}-fast instead to switch back to Wan.
SS_VIDEO_MODEL_I2V=xai/grok-imagine-video
SS_VIDEO_MODEL_T2V=xai/grok-imagine-video
SS_VIDEO_RESOLUTION=480p             # 480p | 720p -- 720p is a 2.5x cost multiplier
SS_IMAGE_MODEL=black-forest-labs/flux-schnell
SS_MUSIC_MODEL=fishaudio/ace-step-1.5 # rhyme mode: lyrics-driven full song
SS_MUSIC_MODEL_INSTRUMENTAL=meta/musicgen  # topical mode: instrumental bed
SS_TTS_MODEL=jaaari/kokoro-82m       # Kokoro TTS on Replicate, for topical narration
SS_TTS_VOICE=af_bella
# SS_TTS_VOICE_HI: voice id used when StyleContract.language is hi/hi-en
SS_TTS_VOICE_HI=

# --- Scene composition (HANDOFF_SPEC_AMENDMENT_01) ---
SS_DEFAULT_SCENE_GEN_MODE=i2v         # i2v | t2v -- Director's default when unsure
SS_SCENE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro  # supports image-conditioning (unused today, see settings.py)

# --- Storage ---
SS_STORAGE_BACKEND=local             # local | s3 | azure_blob
SS_OUTPUT_DIR=./out
SS_CONFIGS_DIR=./configs             # repo-root configs/ (style presets, safety rules, rubrics)
SS_S3_BUCKET=
SS_AWS_REGION=eu-central-1
# SS_AZURE_BLOB_ACCOUNT_URL format: https://<acct>.blob.core.windows.net
SS_AZURE_BLOB_ACCOUNT_URL=
SS_AZURE_BLOB_CONTAINER=storysmith

# --- Database (empty = MemorySaver checkpointing, no cost-ledger persistence) ---
# docker compose up -d postgres  (docker-compose.yml, local dev)
# uv run alembic upgrade head    (creates cost_entries; checkpoint tables are
#                                  created by AsyncPostgresSaver.setup() at
#                                  first run instead -- langgraph owns those)
# SS_DB_URL format: postgresql+psycopg://storysmith:storysmith@localhost:5432/storysmith
SS_DB_URL=

# --- Budget & runtime ---
SS_BUDGET_CAP_USD=12.0
SS_DAILY_BUDGET_CAP_USD=0            # 0 = disabled; requires SS_DB_URL. Refuses new runs once
                                      # today's cost_entries total is at/over this.
SS_DEBUG=0                           # 1 = debugpy wait-for-client in container
SS_SKIP_FFMPEG=0                     # 1 = skip ffmpeg-dependent tests (§5)

# --- Review & publish ---
SS_TELEGRAM_BOT_TOKEN=
SS_TELEGRAM_CHAT_ID=
# SS_API_BEARER_TOKEN: static token protecting the FastAPI console -- pick
# any random string, e.g. `openssl rand -hex 32`. Required: the API fails
# closed (401 on everything) if this is left empty.
SS_API_BEARER_TOKEN=
# review_gate's Telegram message links here; also the apps/api CORS allow-origin.
SS_CONSOLE_BASE_URL=http://localhost:3000
SS_YOUTUBE_CLIENT_SECRETS_PATH=./secrets/yt_client.json
SS_YOUTUBE_TOKEN_PATH=./secrets/yt_token.json  # written by scripts/youtube_auth.py

# --- Observability ---
SS_OPIK_ENABLED=0
# SS_OPIK_API_KEY: only needed for cloud Opik; self-hosted local needs no key
SS_OPIK_API_KEY=
SS_OPIK_URL=http://localhost:5173/api  # self-hosted local Opik instance (note the /api suffix)

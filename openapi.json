    "/shows": {
      "post": {
        "summary": "Create Show",
        "description": "User-authored, frozen cast (Amendment 02) -- no LLM involved. The\nuser's own words become CharacterRef.description/personality directly;\nthis only generates and locks in one reference portrait per character.",
